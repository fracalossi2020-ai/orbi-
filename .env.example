# Sem DATABASE_URL, a PRUMO usa um PostgreSQL embutido (PGlite) em .data/pg — apenas para desenvolvimento.
# Em produção, aponte para um PostgreSQL real:
# DATABASE_URL=postgres://prumo:prumo@localhost:5432/prumo

# Obrigatório em produção (32+ caracteres aleatórios). Em desenvolvimento é gerado em .data/secret.
# AUTH_SECRET=

# Posição manual do motorista (testes sem GPS). Fica ligado em desenvolvimento e desligado em produção.
# ALLOW_MANUAL_LOCATION=true

# --- Integrações externas: sem estas variáveis o recurso fica indisponível e a tela informa ---
# Pix via Mercado Pago
# MERCADOPAGO_ACCESS_TOKEN=

# Mapas (padrões públicos, sem chave; contrate ou hospede os seus antes de operar)
# OSRM_URL=https://router.project-osrm.org
# PHOTON_URL=https://photon.komoot.io
# CEP_URL=https://viacep.com.br

# E-mail (códigos de confirmação e de nova senha). Sem isso, em desenvolvimento, as mensagens vão para .data/outbox.
# Brevo grátis (300/dia): crie a chave SMTP no painel e verifique o remetente.
# SMTP_URL=smtp://LOGIN:CHAVE@smtp-relay.brevo.com:587
# MAIL_FROM="PRUMO <nao-responda@seudominio.com.br>"

# Entrar com Google (gratuito). No Google Cloud: APIs e serviços > Credenciais > Criar ID do cliente OAuth (Aplicativo da Web).
# Em "URIs de redirecionamento autorizados", cadastre: https://SEU_DOMINIO/api/auth/google/callback
# (em desenvolvimento: http://localhost:3000/api/auth/google/callback). Sem estas variáveis o botão não aparece.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# Endereço público do site, usado no retorno do Google quando há proxy na frente:
# APP_URL=https://seudominio.com.br

# --- Segurança (produção) ---
# Com APP_URL em https://, o site liga sozinho: cookies só por HTTPS, HSTS (o navegador recusa a versão sem cadeado)
# e upgrade-insecure-requests na política de conteúdo.
# Gere o AUTH_SECRET com: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
#
# IP real de quem acessa (limites de tentativas). Atrás do proxy da hospedagem, diga quantos proxies há na frente:
# TRUST_PROXY=true
# TRUST_PROXY_HOPS=1
# Se a hospedagem entrega o IP em x-real-ip (Nginx, por exemplo):
# TRUST_X_REAL_IP=true
#
# Equipe (admin, gestor, atendente) só usa o painel com verificação em duas etapas (aplicativo autenticador).
# Desligue apenas em ambiente de teste automatizado:
# PRUMO_REQUIRE_STAFF_MFA=false
#
# Teto de ações por IP a cada 5 minutos (padrão 300):
# PRUMO_WRITE_LIMIT=300
